        <mxCell id="p2_reject_note" value="If policy denies → return MCP error before Jira call. Audit logged with denial reason. Idempotency NOT recorded (so a corrected retry can succeed)." style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999;fontColor=#444;dashed=1;fontSize=11;fontStyle=2;" parent="1" vertex="1">
